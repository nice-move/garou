{
  "name": "garou",
  "version": "0.9.21",
  "description": "Do thing what heroes didn't do",
  "license": "MIT",
  "author": {
    "name": "Eric Chen"
  },
  "keywords": [
    "css",
    "eslint",
    "format",
    "formatter",
    "garou",
    "html",
    "javascript",
    "markdown",
    "nice-move",
    "prettier",
    "react",
    "scss",
    "sort",
    "styleguide",
    "stylelint",
    "typescript",
    "vue"
  ],
  "homepage": "https://www.npmjs.com/package/garou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nice-move/garou.git"
  },
  "bugs": {
    "url": "https://github.com/nice-move/garou/issues"
  },
  "bin": {
    "garou": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "garou": "node dist/cli.mjs",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "prepare": "nice-move git hooks",
    "prepublishOnly": "pnpm run lint:staged && pnpm run lint:type && pnpm test",
    "presnapshot": "pnpm run build",
    "snapshot": "ava --fail-fast -u",
    "pretest": "pnpm run build",
    "test": "ava --fail-fast"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "cheetor": "^0.13.0",
    "eslint-module-utils": "^2.14.0",
    "parse-gitignore": "^2.0.0",
    "stylelint-scss": "^7.2.0",
    "vue-eslint-parser": "~10.4.1"
  },
  "devDependencies": {
    "@bring-it/cli": "^0.11.3",
    "@bring-it/npm": "^0.9.6",
    "@eslint/markdown": "^8.0.3",
    "@ianvs/prettier-plugin-sort-imports": "npm:@nice-move/prettier-plugin-sort-imports@^4.7.1",
    "@nice-move/all-in-web": "^0.9.0",
    "@nice-move/eslint-plugin-html": "0.1.1",
    "@vue/compiler-sfc": "^3.5.42",
    "@yarnpkg/lockfile": "^1.1.0",
    "ava": "^8.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-ava": "^17.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "eslint-plugin-vue": "~10.10.0",
    "espree": "^11.2.0",
    "fs-chain": "^10.0.0",
    "globby": "^16.2.4",
    "micromatch": "^4.0.8",
    "object-traversal": "^1.0.1",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "postcss-markdown": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "~3.9.6",
    "rehype": "^13.0.2",
    "rehype-sort-attributes": "^5.0.1",
    "settingz": "^0.2.0",
    "slash": "^5.1.0",
    "sort-keys": "^6.0.1",
    "stylelint": "^17.14.1",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0",
    "yarn-deduplicate": "^6.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.9.1",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "^10.33.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "ava": {
    "extensions": [
      "mts"
    ],
    "timeout": "2m",
    "watchMode": {
      "ignoreChanges": [
        "**/temp/**"
      ]
    }
  },
  "nice-move": {
    "bundle": [
      "lib/**"
    ],
    "ignore": {
      "all": [
        "test/fixture/source/**"
      ],
      "eslint": [
        "test/helper/temp/**"
      ]
    }
  },
  "prettier": "@nice-move/all-in-web/prettier",
  "stylelint": {
    "extends": "@nice-move/all-in-web/stylelint"
  }
}
